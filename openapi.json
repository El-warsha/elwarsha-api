    "/api/v1/cohorts/{slug}/applications": {
      "post": {
        "operationId": "ApplicationsController_apply",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "The cohort slug (e.g. cohort-2)",
            "schema": {
              "example": "cohort-2"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Application successfully received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "app_7b2f1e9a"
                    },
                    "cohortSlug": {
                      "type": "string",
                      "example": "cohort-2"
                    },
                    "email": {
                      "type": "string",
                      "example": "ahmed@example.com"
                    },
                    "status": {
                      "type": "string",
                      "example": "received"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Application already submitted with this email or GitHub handle"
          },
          "422": {
            "description": "Validation failed with structured invalidParams list"
          }
        },
        "summary": "Submit an application to join a cohort",
        "tags": [
          "cohorts"
        ]
      }
    },
