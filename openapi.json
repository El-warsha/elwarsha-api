    "/api/v1/cohorts/{cohortSlug}/weeks": {
      "get": {
        "description": "Returns all 8 weeks for the specified cohort, including lock status and current week information.",
        "operationId": "WeeksController_listWeeks",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "The response language",
            "schema": {
              "enum": [
                "ar",
                "en"
              ],
              "type": "string"
            }
          },
          {
            "name": "cohortSlug",
            "required": true,
            "in": "path",
            "description": "The unique slug of the cohort",
            "schema": {
              "example": "cohort-01",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get all weeks for a cohort",
        "tags": [
          "weeks"
        ]
      }
    },
    "/api/v1/cohorts/{cohortSlug}/weeks/{weekNumber}": {
      "get": {
        "description": "Returns the details of a specific week, including its content, assignment, and resources.",
        "operationId": "WeeksController_getWeek",
        "parameters": [
          {
            "name": "locale",
            "required": false,
            "in": "query",
            "description": "The response language",
            "schema": {
              "enum": [
                "ar",
                "en"
              ],
              "type": "string"
            }
          },
          {
            "name": "weekNumber",
            "required": true,
            "in": "path",
            "description": "The week number, from 1 to 8",
            "schema": {
              "example": 3,
              "type": "number"
            }
          },
          {
            "name": "cohortSlug",
            "required": true,
            "in": "path",
            "description": "The unique slug of the cohort",
            "schema": {
              "example": "cohort-01",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get week details",
        "tags": [
          "weeks"
        ]
      }
    },
